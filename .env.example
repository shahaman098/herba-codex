# Herba Codex — LLM configuration (OpenAI-compatible)
# Local Ollama (default for reproducible demo):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b

# Cloud upgrade (optional): e.g. Gemini OpenAI-compat endpoint
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.0-flash

# Per-agent overrides (optional, same client):
LLM_MODEL_HISTORIAN=
LLM_MODEL_BOTANIST=
LLM_MODEL_PHARMACOLOGIST=
LLM_MODEL_SCORER=
LLM_MODEL_AUDITOR=

# Pipeline
HC_MAX_ENTRIES=0          # 0 = all segmented entries
HC_TRACE_DIR=trace
